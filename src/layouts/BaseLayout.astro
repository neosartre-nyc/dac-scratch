---
// src/layouts/BaseLayout.astro
const { title = "Dangerous Angels Creative" } = Astro.props;
import "../styles/global.css";
import { Image } from "astro:assets";
import Logo from "../images/dac_logo.png";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <header>
    <nav class="bg-dark">
      <a class="nav-header" href="/">
        <Image src={Logo} alt="logo" />
        <p><h3>Dangerous Angels Creative</h3></p>
      </a>
      <ul class="list-reset nav-list">
        <li><a href="/">About</a></li>
        <li>
          <a href="https://www.behance.net/natalier9" target="_blank"
            >Portfolio</a
          >
        </li>
        <li><a href="/projects">Projects</a></li>
        <li><a href="/resumenatalie">Résumé</a></li>
        <li><a href="/journal">Journal</a></li>
        <li>
          <a href="https://videos.dangerousangelscreative.com/" target="_blank"
            >Videos</a
          >
        </li>
      </ul>
    </nav>
  </header>
  <body>
    <slot />
  </body>

  <!-- //  FOOTER  // -->

  <footer id="contact" class="bg-dark">
    <h2>Demystify the Real!</h2>
    <p>
      Email me at <a href="mailto:natalie@dangerousangelscreative.com"
        >natalie@dangerousangelscreative.com</a
      > or visit one of the links below.
    </p>
    <ul class="list-reset socials-list">
      <li>
        <a
          href="https://www.youtube.com/@DangerousAngelsCreative"
          target="_blank"
        >
          <img src="images/icon-youtube.png" alt="DAC YouTube channel" />
        </a>
      </li>
      <li>
        <a
          href="https://www.instagram.com/dangerousangelscreative/"
          target="_blank"
        >
          <img src="images/icon-instagram.png" alt="Instagram account" />
        </a>
      </li>
      <li>
        <a href="https://linkedin.com/in/neosartre" target="_blank">
          <img src="images/icon-linkedin.png" alt="LinkedIn profile" />
        </a>
      </li>
      <li>
        <a
          href="https://bsky.app/profile/dangerousangels.bsky.social"
          target="_blank"
        >
          <img src="images/icon-bluesky.png" alt="Bluesky account" />
        </a>
      </li>
      <li>
        <a href="https://ko-fi.com/dangerousangelscreative
" target="_blank">
          <img src="images/icon-ko-fi.png" alt="Ko-fi account" />
        </a>
      </li>
    </ul>
    <p class="copyright">© 2026 by Dangerous Angels Creative</p>
  </footer>


</html>
