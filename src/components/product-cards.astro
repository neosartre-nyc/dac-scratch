---
import "../styles/global.css";
import { Image } from "astro:assets";
import World from "../images/dac-worldBuilding.webp";
import Combat from "../images/dac-brandCombat.webp";
import Construct from "../images/dac-construct.webp";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Products</title>
  </head>
  <body>
    <div class="product-grid">
      <div class="product-card" ; onclick="window.location.href='/'">
        <Image src={World} alt="worldBuilding" />
        <h3 class="product-card--label">Culture Displaces Campaigns</h3>
      </div>
      <div class="product-card" ; onclick="window.location.href='/combat'">
        <Image src={Combat} alt="brandCombat" />
        <h3 class="product-card--label">Brand Architecture as Weaponry</h3>
      </div>
      <div class="product-card">
        <Image src={Construct} alt="construction" />
        <h3 class="product-card--label">Coming Soon!</h3>
      </div>
    </div>
  </body>
</html>
