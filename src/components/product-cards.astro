---
import "../styles/global.css";
import { Image } from "astro:assets";
import World from "../images/dac-worldBuilding.webp";
import Combat from "../images/dac-brandCombat.webp";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Products</title>
  </head>
  <body>
    <div class="product-grid">
      <div class="product-card" ; onclick="window.location.href='/'">
        <Image src={World} alt="worldBuilding" />
        <h3 class="product-card--label">Building a Universe 1</h3>
      </div>
      <div class="product-card" ; onclick="window.location.href='/combat'">
        <Image src={Combat} alt="brandcombat" />
        <h3 class="product-card--label">Competitive</h3>
      </div>
      <div class="product-card">
        <h3 class="product-card--label">Blank</h3>
      </div>
    </div>
  </body>
</html>
