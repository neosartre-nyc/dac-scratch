---
//stylesheet
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Fluxus</title>
  </head>
  <body>
    <div id="fluxus">
      <h2 style="margin: 2rem 0rem 1rem 0rem">
        Please answer this question very carefully
      </h2>
      <label class="check-list"
        >Yes
        <input type="checkbox" />
        <span class="checkmark"></span>
      </label>
      <label class="check-list"
        >No
        <input type="checkbox" />
        <span class="checkmark"></span>
      </label>
      <a href="/"><h2 style="margin-top: 1rem;">Enter</h2></a>
    </div>
  </body>
</html>
