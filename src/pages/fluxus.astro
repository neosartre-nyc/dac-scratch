---
import BaseLayoutAstroComponent from "../layouts/BaseLayout.astro";
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Fluxus</title>
  </head>
  <body> </body>
</html>

<BaseLayoutAstroComponent>
  <body>
    <div class="wrapper wrapper--checklist">
      <h1 style="margin-top: 2rem;">Fluxus</h1>
      <h2 style="margin: 2rem 0rem 1rem 0rem">
        Please answer this question very carefully:
      </h2>
      <label class="checklist"
        >Yes
        <input type="checkbox" />
        <span class="checkmark"></span>
      </label><br />
      <label class="checklist"
        >No
        <input type="checkbox" />
        <span class="checkmark"></span>
      </label><br />
      <button class="button button--red" onclick="location.href='/'"
        ><b>Enter</b></button
      >
    </div>
  </body>
</BaseLayoutAstroComponent>

<style>
  .checklist {
    display: block;
    position: relative;
    display: block;
    width: 100%;
    padding-left: 35px;
    margin-bottom: 12px;
    cursor: pointer;
    font-size: 22px;
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none;
  }

  /* Hide the browser's default checkbox */
  .checklist input {
    position: absolute;
    opacity: 0;
    cursor: pointer;
    height: 0;
    width: 0;
  }

  /* Create a custom checkbox */
  .checkmark {
    position: absolute;
    top: 0;
    left: 0;
    height: 25px;
    width: 25px;
    background-color: var(--metallicseaweed);
  }

  /* On mouse-over, add a grey background color */
  .checklist:hover input ~ .checkmark {
    background-color: var(--glossyyellow);
  }

  /* When the checkbox is checked, add a blue background */
  .checklist input:checked ~ .checkmark {
    background-color: var(--richvelvetred);
  }

  /* Create the checkmark/indicator (hidden when not checked) */
  .checkmark:after {
    content: "";
    position: absolute;
    display: none;
  }

  /* Show the checkmark when checked */
  .checklist input:checked ~ .checkmark:after {
    display: block;
  }

  /* Style the checkmark/indicator */
  .checklist .checkmark:after {
    left: 9px;
    top: 5px;
    width: 5px;
    height: 10px;
    border: solid white;
    border-width: 0 3px 3px 0;
    -webkit-transform: rotate(45deg);
    -ms-transform: rotate(45deg);
    transform: rotate(45deg);
  }
</style>
