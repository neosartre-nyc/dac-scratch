---
import BaseLayoutAstroComponent from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import CovSmall from "../images/cov_wmS.png";
---

<html lang="en">
  <link href="/css/styles.css" rel="stylesheet" />

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Journal</title>
  <BaseLayoutAstroComponent>
    <main style="padding-top: 100px;">
      <!-- //  PROJECTS  // -->
      <section id="projects" class="content-wrapper">
        <h2>Projects</h2>
        <p>A selection of projects.</p>
        <!-- Add more projects by copying the whole <section> block. -->
        <section class="project-item">
          <Image src={CovSmall} alt="projectImage" />
          <div class="project-details">
            <h3>More Than Just Talk</h3>
            <p>Brand Building Thesis</p>
            <a href="http://shunyamark.com/solut/" target="_blank"
              >Link To Thesis</a
            >
            <!-- Optional: use this list if you have multiple links for the project -->
            <!-- <ul>
          <li><a href="https://update.me" target="_blank">Link 1</a></li>
          <li><a href="https://update.me" target="_blank">Link 2</a></li>
          <li><a href="https://update.me" target="_blank">Link 3</a></li>
        </ul> -->
          </div>
        </section>
      </section>
      <!-- end of PROJECTS -->
    </main>
  </BaseLayoutAstroComponent>
</html>
