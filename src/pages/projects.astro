---
import BaseLayoutAstroComponent from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import "../styles/global.css";
import CovSmall from "../images/cov_wmS.png";
---

<html lang="en">
  <link href="/css/styles.css" rel="stylesheet" />

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Journal</title>
  <BaseLayoutAstroComponent>
    <main style="padding-top: 100px;">
      <section id="projects" class="wrapper wrapper--narrow-background">
        <h2>Projects</h2>
        <p>A selection of projects.</p>

        <section class="project-item">
          <Image src={CovSmall} alt="project image" />
          <div class="project-details">
            <h3>More Than Just Talk</h3>
            <p>Brand Building Thesis</p>
            <a
              href="https://shunyamark.com/solut/"
              target="_blank"
              rel="noopener noreferrer"
            >
              Link To Thesis
            </a>
          </div>
        </section>
      </section>
    </main>
  </BaseLayoutAstroComponent>
</html>
