---
import BaseLayoutAstroComponent from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import Summa from "../images/ReuchleinN_MDM_ResumeFinal.png";
---

<html lang="en">
  <link href="/css/styles.css" rel="stylesheet" />

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Journal</title>
  <BaseLayoutAstroComponent>
    <main style="padding-top: 100px;">
      <!-- //  RESUME  // -->
      <div class="wrapper wrapper--default">
        <section id="resume">
          <h2>Résumé</h2>
          <Image
            src={Summa}
            alt="Resume"
            width={2000}
            sizes="100vw"
            style="max-width: 100%; height: auto;"
          />
        </section>
      </div>
      <!-- end of RESUME -->
    </main>
  </BaseLayoutAstroComponent>
</html>
